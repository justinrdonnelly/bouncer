<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="NetworksBox" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>

    <!-- Network dropdown -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="margin-top">24</property>
        <property name="margin-bottom">24</property>
        <property name="halign">GTK_ALIGN_START</property> <!-- make the dropdown not span the entire box -->
        <property name="title" translatable="yes">Manage Networks</property>
        <property name="description" translatable="yes">Manage your configured networks from here.</property>
        <child>
          <object class="AdwComboRow" id="comboRow">
            <property name="title" translatable="yes">Networks</property>
            <property name="enable-search">True</property>
            <property name="search-match-mode">GTK_STRING_FILTER_MATCH_MODE_SUBSTRING</property>
            <property name="model">
              <object class="GtkStringList" id="networks">
                <items/>
              </object>
            </property>
            <property name="expression">
              <lookup type="GtkStringObject" name="string"/>
            </property>
          </object>
        </child>
      </object> <!-- end group -->
    </child>
    <child>
      <object class="GtkListBox">
        <property name="selection-mode">none</property>
        <property name="width-request">300</property>
        <property name="halign">GTK_ALIGN_START</property> <!-- make the list box not span the entire box -->
        <style>
          <class name="boxed-list"/>
        </style>
        <child>
          <object class="AdwActionRow" id="currentZone">
            <property name="title" translatable="yes">Current Zone</property>
            <property name="subtitle-selectable">True</property>
            <style>
              <class name="property"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
