{
    "id": "io.github.justinrdonnelly.bouncer",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "io.github.justinrdonnelly.bouncer",
    "finish-args": [
        "--socket=wayland",
        "--device=dri",
        "--socket=fallback-x11",
        "--share=ipc",
        "--system-talk-name=org.freedesktop.NetworkManager",
        "--system-talk-name=org.fedoraproject.FirewallD1"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/gir-1.0"
    ],
    "modules": [
        {
            "name": "libportal",
            "buildsystem": "meson",
            "config-opts": [
                "--libdir=/app/lib",
                "-Dbackend-gtk3=disabled",
                "-Dbackend-gtk4=enabled",
                "-Dbackend-qt5=disabled",
                "-Dbackend-qt6=disabled",
                "-Ddocs=false",
                "-Dtests=false",
                "-Dvapi=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/flatpak/libportal/releases/download/0.11.0/libportal-0.11.0.tar.xz",
                    "sha256": "abb9e452a1c372133bd3eb8f0bb30d07b2d0a8fb02001c4155cf287555db4040"
                }
            ]
        },
        {
            "name": "bouncer",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/justinrdonnelly/bouncer.git",
                    "branch": "51"
                }
            ]
        }
    ]
}
